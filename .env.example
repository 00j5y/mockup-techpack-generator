# Constitue Studio : gabarit d'environnement
# Copier en .env.local et renseigner. .env.local n'est jamais committe.
#
# Regle : toute variable SANS prefixe NEXT_PUBLIC_ est inaccessible cote client.
# Si une cle secrete "a besoin" du prefixe pour fonctionner, c'est que l'appel
# est au mauvais endroit.

# --- Base de donnees --------------------------------------------------------
# Postgres auto-heberge, lance par `docker compose up -d db`.
# Depuis l'hote (bun run dev, drizzle-kit) : localhost.
# Depuis le conteneur applicatif : docker-compose ecrase avec l'hote `db`.
DATABASE_URL=postgres://constitue:constitue@localhost:5432/constitue_studio

# --- Stockage fichiers ------------------------------------------------------
# Vide en local : le stockage tombe dans ./.storage
# En conteneur : renseigne par docker-compose sur un volume persistant.
STORAGE_DIR=

# --- OpenAI (Phase 5) -------------------------------------------------------
# Serveur uniquement.
OPENAI_API_KEY=

# --- Puppeteer (Phase 4) ----------------------------------------------------
# Vides en local : Puppeteer utilise le Chromium qu'il a telecharge.
# En Docker, renseignes par docker-compose pour pointer sur le Chromium systeme.
PUPPETEER_EXECUTABLE_PATH=
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
