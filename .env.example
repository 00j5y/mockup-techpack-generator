# Constitue Studio : gabarit d'environnement
# Copier en .env.local et renseigner. .env.local n'est jamais committe.
#
# Regle : toute variable SANS prefixe NEXT_PUBLIC_ est inaccessible cote client.
# Si une cle secrete "a besoin" du prefixe pour fonctionner, c'est que l'appel
# est au mauvais endroit.

# --- Base de donnees --------------------------------------------------------
# Postgres auto-heberge, lance par `docker compose up -d db`.
# Depuis l'hote (bun run dev, drizzle-kit) : localhost.
# Depuis le conteneur applicatif : docker-compose ecrase avec l'hote `db`.
DATABASE_URL=postgres://constitue:constitue@localhost:5432/constitue_studio

# --- Stockage fichiers ------------------------------------------------------
# Vide en local : le stockage tombe dans ./.storage
# En conteneur : renseigne par docker-compose sur un volume persistant.
STORAGE_DIR=

# --- Polices locales --------------------------------------------------------
# Racine servie par /api/fonts/[...path]. Y deposer MyriadPro-Bold.ttf, la vraie
# police du template Seaggs, qui n'est PAS versionnee.
# Vide en local : la racine tombe sur ./assets/fonts
# En conteneur : renseigne par docker-compose sur le montage en lecture seule.
# Fichier absent = 404 et repli sur Source Sans 3, rien ne casse.
# Voir assets/fonts/README.md.
FONTS_DIR=

# --- OpenAI (Phase 5) -------------------------------------------------------
# Serveur uniquement.
OPENAI_API_KEY=

# --- Puppeteer (Phase 4) ----------------------------------------------------
# Vides en local : Puppeteer utilise le Chromium qu'il telecharge a l'install.
# En Docker, renseignes pour pointer sur le Chromium systeme.
# Le nom est PUPPETEER_SKIP_DOWNLOAD (et non ..._SKIP_CHROMIUM_DOWNLOAD, ancien
# et ignore en silence).
PUPPETEER_EXECUTABLE_PATH=
PUPPETEER_SKIP_DOWNLOAD=

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
